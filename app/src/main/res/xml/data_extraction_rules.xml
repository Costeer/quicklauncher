<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="database" path="quicklauncher.db" />
        <include domain="file" path="datastore/launcher-preferences.pb" />
        <include domain="file" path="theme-assets" />
        <include domain="sharedpref" path="portable-backup-web-adapters.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="quicklauncher.db" />
        <include domain="file" path="datastore/launcher-preferences.pb" />
        <include domain="file" path="theme-assets" />
        <include domain="sharedpref" path="portable-backup-web-adapters.xml" />
    </device-transfer>
</data-extraction-rules>
